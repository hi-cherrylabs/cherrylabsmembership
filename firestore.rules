rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = whoever is signed in with the Cherry Labs Google account.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'hello.cherrylabs@gmail.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNotBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true;
    }

    /* ------------------------------ Members ------------------------------- */
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    /* --------------------------- Community chat ---------------------------- */
    match /community_messages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isNotBanned();
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ---------------------- Suggestions / support chat ---------------------- */
    match /suggestions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();

      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && request.resource.data.sender == 'user')
                      || (isAdmin() && request.resource.data.sender == 'admin');
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    /* ----------------------------- Applications ------------------------------ */
    match /applications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* -------------------- Posts (announcements + what's new) -------------------- */
    match /posts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* --------------------------------- Settings --------------------------------- */
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
