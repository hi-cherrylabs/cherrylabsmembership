rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Super Admin = strictly hello.cherrylabs@gmail.com
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'hello.cherrylabs@gmail.com';
    }

    // Admin = Super Admin OR user document has isAdmin == true
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNotBanned() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned != true;
    }

    /* ------------------------------ Members ------------------------------- */
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && (isSuperAdmin() || request.resource.data.isAdmin != true);
      allow update: if isAdmin() || (
        isOwner(uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned'])) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['employeeRoles']) ||
          request.resource.data.employeeRoles == resource.data.employeeRoles ||
          (
            request.resource.data.employeeRoles.hasAll(resource.data.employeeRoles) &&
            exists(/databases/$(database)/documents/employee_tokens/$(uid + '_' + request.resource.data.employeeRoles[request.resource.data.employeeRoles.size() - 1])) &&
            get(/databases/$(database)/documents/employee_tokens/$(uid + '_' + request.resource.data.employeeRoles[request.resource.data.employeeRoles.size() - 1])).data.status == 'redeemed'
          )
        ) &&
        (
          request.resource.data.isAdmin == resource.data.isAdmin ||
          (
            request.resource.data.isAdmin == true &&
            request.resource.data.adminTokenId != null &&
            get(/databases/$(database)/documents/admin_tokens/$(request.resource.data.adminTokenId)).data.email.lower() == request.auth.token.email.lower() &&
            get(/databases/$(database)/documents/admin_tokens/$(request.resource.data.adminTokenId)).data.used == true
          )
        )
      );
      allow delete: if isAdmin();
    }

    /* --------------------------- Admin Tokens ----------------------------- */
    match /admin_tokens/{id} {
      allow read: if isSuperAdmin() || (isSignedIn() && resource.data.email.lower() == request.auth.token.email.lower());
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isSignedIn() &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        resource.data.used == false &&
        request.resource.data.used == true
      );
    }

    /* -------------------------- Employee Tokens ---------------------------- */
    match /employee_tokens/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid
      );
    }

    /* --------------------------- Community chat ---------------------------- */
    match /community_messages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && isNotBanned();
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ---------------------- Suggestions / support chat ---------------------- */
    match /suggestions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();

      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && request.resource.data.sender == 'user')
                      || (isAdmin() && request.resource.data.sender == 'admin');
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    /* ----------------------------- Applications ------------------------------ */
    match /applications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'uid', 'role', 'tokenCode', 'tokenStatus', 'tokenType', 'tokenExpiresAt']))
      );
      allow delete: if isAdmin();
    }

    /* -------------------- Posts (announcements + what's new) -------------------- */
    match /posts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* --------------------------------- Settings --------------------------------- */
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /* ------------------------------ Role Content -------------------------------- */
    match /role_contents/{role} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
