rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Permanent super admin check
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'hello.cherrylabs@gmail.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* ------------------------------ Members ------------------------------- */
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    /* --------------------------- Community chat ---------------------------- */
    match /community_messages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isSignedIn();
    }

    /* ---------------------- Suggestions / support chat ---------------------- */
    match /suggestions/{uid} {
      allow read, write: if isSignedIn();

      match /messages/{msgId} {
        allow read, create, delete: if isSignedIn();
        allow update: if false;
      }
    }

    /* ----------------------------- Applications ------------------------------ */
    match /applications/{id} {
      allow read, create, update, delete: if isSignedIn();
    }

    /* -------------------- Posts (announcements + what's new) -------------------- */
    match /posts/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /* --------------------------------- Settings --------------------------------- */
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /* ----------------------------- Admin Tokens --------------------------------- */
    match /admin_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }
  }
}
